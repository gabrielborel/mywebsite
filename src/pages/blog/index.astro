---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { slugify } from '../../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Tags unicas, na grafia do primeiro post em que aparecem.
const tags = new Map<string, string>();
for (const p of posts) for (const t of p.data.tags) if (!tags.has(slugify(t))) tags.set(slugify(t), t);
---

<Base title="Blog" description="Posts sobre firmware, eletrônica e matemática.">
  <div class="container">
    <header class="page-head">
      <p class="label">Blog</p>
      <h1 class="display-l">Anotações e registros de projetos e estudos</h1>
      <p class="body-l page-head__lede">
        Firmware, eletrônica e matemática. Posts sobre o que eu estiver fazendo.
      </p>
      {
        tags.size > 0 && (
          <ul class="chips" style="margin-top: var(--space-5);" aria-label="Tags">
            {[...tags].map(([slug, label]) => (
              <li>
                <a class="chip" href={`/blog/tags/${slug}/`}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <div style="padding-bottom: var(--space-9);">
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <PostRow post={post} />
            ))}
          </ul>
        ) : (
          <p class="body-l">Nenhum post publicado ainda.</p>
        )
      }
    </div>
  </div>
</Base>
