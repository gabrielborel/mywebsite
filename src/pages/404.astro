---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <div class="container">
    <header class="page-head" style="padding-bottom: var(--space-9);">
      <p class="label">Erro 404</p>
      <h1 class="display-l">Página não encontrada.</h1>
      <p class="body-l page-head__lede">O endereço não existe ou mudou de lugar.</p>
      <div class="btn-row" style="margin-top: var(--space-6);">
        <a class="btn btn--primary" href="/">Voltar ao início</a>
      </div>
    </header>
  </div>
</Base>
